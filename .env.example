# Copy to .env and fill in. Start Postgres first: docker compose up -d

DATABASE_URL="postgresql://bazi:bazi_dev_password@localhost:5433/bazi?schema=public"

# Generate with: npx auth secret
AUTH_SECRET=""
# Leave AUTH_URL unset in development — with AUTH_TRUST_HOST the host comes from
# the request, so the app works on whatever port it gets. Pin it in production.
AUTH_TRUST_HOST=true
# AUTH_URL="https://your-domain"

# Optional. Leave blank to hide the Google button and use email/password only.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional. Without a key the app falls back to the deterministic template
# renderer — daily readings still work, they are just plainer.
ANTHROPIC_API_KEY=""

# Protects the daily digest cron endpoint.
CRON_SECRET=""

# Optional. Leave blank to disable the daily email.
RESEND_API_KEY=""
EMAIL_FROM="Bát Tự <onboarding@resend.dev>"
ADMIN_EMAIL="admin@example.com"
