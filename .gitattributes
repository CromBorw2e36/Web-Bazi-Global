* text=auto

# Anything the Linux containers execute or parse must keep LF endings, whatever
# the checkout platform does. A CRLF shebang fails as "no such file or
# directory", which reads like a missing file rather than a line-ending bug.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
*.conf text eol=lf
